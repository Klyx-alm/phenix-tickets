APP_NAME="Phenix Tickets"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BJ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de donnees (SQLite par defaut, MySQL recommande en production)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=phenix_tickets
# DB_USERNAME=phenix
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Passer a true en production (HTTPS obligatoire)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis (optionnel, ameliore les performances)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (SMTP requis en production pour envoyer les billets)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tickets@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# FedaPay (paiement mobile money)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

# Delai avant reversement organisateur (jours apres fin evenement)
PAYOUT_DELAY_DAYS=3

# Informations de la societe (mentions legales)
COMPANY_NAME="Phenix Agency"
COMPANY_LEGAL_FORM=
COMPANY_ADDRESS=
COMPANY_RCCM=
COMPANY_IFU=
COMPANY_EMAIL=
COMPANY_DIRECTOR=
COMPANY_HOST=

VITE_APP_NAME="${APP_NAME}"
